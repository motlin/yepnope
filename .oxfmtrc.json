{
	"braceStyle": "next-line",
	"semi": true,
	"singleQuote": false,
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 120,
	"bracketSpacing": false,
	"trailingComma": "all",
	"arrowParens": "always",
	"overrides": [
		{
			"files": [".yamllint.yaml", "**/*.yaml", "**/*.yml"],
			"options":
			{
				"useTabs": false,
				"tabWidth": 2
			}
		}
	]
}

{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	// src/**/*.mdx mirrors the Storybook stories glob in .storybook/main.ts;
	// fallow's storybook plugin only detects *.stories.* files, not docs pages.
	"entry": [
		"src/index.{ts,tsx,js,jsx}",
		"src/main.{ts,tsx,js,jsx}",
		"src/**/*.mdx",
		"worker/index.ts",
		// The service worker is fetched by URL at runtime; the icon script is run by hand.
		"public/sw.js",
		"scripts/generate-icons.mjs",
		"scripts/admin-storage.ts",
		"scripts/browser-test-prepare.ts",
		"scripts/browser-test-server.ts",
		"worker/admin.ts",
		"worker/browser-e2e.ts",
		"tests/browser/**/*.spec.ts",
		// The deployed core-loop check runs against a Cloudflare deployment, not a local server, so
		// it has its own Playwright config and is never reached from playwright.config.ts.
		"playwright.deployed.config.ts",
		"tests/deployed/**/*.spec.ts",
		"worker/tests/**/*.test.ts",
		"worker/tests/apply-migrations.ts",
		"drizzle-do.config.ts",
		"drizzle-d1.config.ts",
	],
	"ignorePatterns": [".storybook/**"],
	// Referenced only from .storybook/main.ts, the test-storybook script, and
	// the eslint block in vite.config.ts — places fallow does not scan.
	"ignoreDependencies": [
		"@chromatic-com/storybook",
		"@storybook/addon-a11y",
		"@storybook/addon-docs",
		"@storybook/addon-onboarding",
		"@storybook/addon-vitest",
		"@storybook/react-vite",
		"@storybook/test-runner",
		"eslint-plugin-storybook",
		"jiti",
	],
	"rules": {
		"unused-dependencies": "warn",
	},
	"ignoreExports": [
		{
			"file": "worker/tests/push-helpers.ts",
			"exports": ["*"],
		},
		{
			"file": "worker/webpush.ts",
			"exports": ["*"],
		},
	],
}

{
	"description": "Try YepNope before Codex asks the user a question.",
	"hooks": {
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$PLUGIN_ROOT/codex-hooks/route-questions.cjs\"",
						"timeout": 5
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "(^|__)ask_yep_nope$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$PLUGIN_ROOT/codex-hooks/route-questions.cjs\"",
						"timeout": 5
					}
				]
			},
			{
				"matcher": "^(request_user_input|AskUserQuestion)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$PLUGIN_ROOT/codex-hooks/route-questions.cjs\"",
						"timeout": 5
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "(^|__)ask_yep_nope$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$PLUGIN_ROOT/codex-hooks/route-questions.cjs\"",
						"timeout": 5
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$PLUGIN_ROOT/codex-hooks/route-questions.cjs\"",
						"timeout": 5
					}
				]
			}
		]
	}
}

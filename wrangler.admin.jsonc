{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "yepnope-admin",
	"main": "worker/admin.ts",
	"compatibility_date": "2026-08-18",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{"pattern": "admin.yepnope.app", "custom_domain": true}],
	"durable_objects": {
		"bindings": [{"name": "USER_DO", "class_name": "UserDurableObject", "script_name": "yepnope"}],
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "yepnope",
			"database_id": "c01bc768-a27b-4c08-b7b1-bd8c6963c60d",
		},
	],
	"observability": {
		"enabled": true,
		"logs": {"enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true},
		"traces": {"enabled": true, "head_sampling_rate": 1, "persist": true},
	},
}

{
	"name": "yepnope",
	"version": "0.0.0",
	"description": "Swipe to answer your coding agent's yes/no questions.",
	"type": "module",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "vp dev",
		"preview": "vp preview",
		"check": "vp check",
		"build": "vp build",
		"oxlint": "vp lint . --fix",
		"oxlint:ci": "vp lint . --format github",
		"fmt": "vp fmt",
		"fmt:ci": "vp fmt --check",
		"fallow": "fallow fix --yes",
		"fallow:ci": "fallow dead-code",
		"typecheck": "wrangler types --env-file /dev/null && tsc --noEmit && tsc -p worker/tsconfig.json && tsc -p cli/tsconfig.json",
		"test": "node node_modules/vitest/dist/cli.js",
		"test:browser": "node --experimental-strip-types scripts/browser-test-prepare.ts && node node_modules/playwright/cli.js test --config playwright.config.ts",
		"test:ui": "node node_modules/vitest/dist/cli.js --ui",
		"proof:oauth-mcp": "node --experimental-strip-types tests/oauth-mcp-proof/codex-proof-server.ts",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test-storybook": "npx concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"npx http-server storybook-static --port 6006 --silent\" \"npx wait-on tcp:127.0.0.1:6006 && test-storybook\"",
		"prepare": "VITE_GIT_HOOKS=0 vp config",
		"test:worker": "node node_modules/vitest/dist/cli.js run --config vitest.worker.config.ts",
		"dry-run:oauth-client-reclamation": "node --experimental-strip-types scripts/oauth-client-reclamation.ts",
		"smoke:skills-install": "node --experimental-strip-types scripts/skill-install-smoke.ts",
		"smoke:codex-oauth": "node --experimental-strip-types scripts/codex-oauth-smoke.ts",
		"smoke:verification-delivery": "node --experimental-strip-types scripts/verification-delivery-smoke.ts",
		"smoke:sign-in-surface": "node node_modules/playwright/cli.js test --config playwright.deployed.config.ts tests/deployed/sign-in-surface.spec.ts",
		"check:deployment": "node --experimental-strip-types scripts/deployment-check.ts",
		"enroll:deployment-passkey": "node --experimental-strip-types scripts/deployment-check.ts --enroll",
		"admin:storage": "node scripts/admin-storage.ts",
		"deploy:admin": "wrangler deploy --config wrangler.admin.jsonc --keep-vars",
		"deploy": "vp build && wrangler deploy",
		"build:cli": "esbuild cli/main.ts --bundle --minify --platform=node --target=node20 --format=cjs --outfile=cli/dist/yepnope.cjs --banner:js='#!/usr/bin/env node' --log-level=warning"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.0",
		"@better-auth/mcp": "1.7.0",
		"@better-auth/oauth-provider": "1.7.0",
		"@better-auth/passkey": "1.7.0",
		"@simplewebauthn/browser": "^13.3.0",
		"agentation": "^3.0.2",
		"better-auth": "1.7.0",
		"drizzle-orm": "^0.45.2",
		"jose": "6.2.9",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@better-auth/memory-adapter": "1.7.0",
		"@chromatic-com/storybook": "^5.3.0",
		"@cloudflare/vitest-pool-workers": "^0.21.3",
		"@modelcontextprotocol/sdk": "1.30.0",
		"@modelcontextprotocol/server": "2.0.0",
		"@storybook/addon-a11y": "^10.5.8",
		"@storybook/addon-docs": "^10.5.8",
		"@storybook/addon-onboarding": "^10.5.8",
		"@storybook/addon-vitest": "^10.5.8",
		"@storybook/react-vite": "^10.5.5",
		"@storybook/test-runner": "^0.24.4",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.5",
		"drizzle-kit": "^0.31.10",
		"esbuild": "^0.28.2",
		"eslint": "^10.8.0",
		"eslint-plugin-storybook": "^10.5.8",
		"fallow": "^3.20.0",
		"jiti": "^2.7.0",
		"jsdom": "^30.0.1",
		"markdownlint-cli2": "^0.23.2",
		"playwright": "^1.62.0",
		"storybook": "^10.5.5",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"wrangler": "^4.123.0"
	},
	"packageManager": "pnpm@11.1.1"
}

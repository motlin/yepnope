{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "yepnope",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-01",
	"routes": [{"pattern": "yepnope.app/api/*", "zone_name": "yepnope.app"}],
	"durable_objects": {
		"bindings": [{"name": "USER_DO", "class_name": "UserDurableObject"}],
	},
	"migrations": [{"tag": "v1", "new_sqlite_classes": ["UserDurableObject"]}],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "yepnope",
			"database_id": "063099d0-41c7-4b2b-8f6d-2acf3e9aac2f",
			"migrations_dir": "worker/migrations/d1",
		},
	],
	"rules": [{"type": "Text", "globs": ["**/*.sql"], "fallthrough": true}],
	// 🔑 Committed key is for local dev and tests only; production overrides both via `wrangler secret put`.
	"vars": {
		"VAPID_PRIVATE_JWK": "{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"P2UcKzI-O7pCxMgZn7O1nuxR0PhhT6mT6tOykdMFguU\",\"y\":\"l-fC1-ic-sn3gMPXjJdSkP_PS55_eSOZ6WNobUL0gto\",\"d\":\"Ns5xclmJIPX3nl-JGchKKjUTJsrYm-TTrhG0UKSjjXc\"}",
		"VAPID_SUBJECT": "mailto:push@yepnope.app",
	},
	"observability": {"enabled": true},
}

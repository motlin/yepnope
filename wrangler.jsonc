{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "yepnope",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-17",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [{"pattern": "yepnope.app", "custom_domain": true}],
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/.well-known/*"],
	},
	"triggers": {"crons": ["0 4 * * *"]},
	"durable_objects": {
		"bindings": [{"name": "USER_DO", "class_name": "UserDurableObject"}],
	},
	"migrations": [{"tag": "v1", "new_sqlite_classes": ["UserDurableObject"]}],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "yepnope",
			"database_id": "c01bc768-a27b-4c08-b7b1-bd8c6963c60d",
			"migrations_dir": "worker/migrations/d1",
		},
	],
	"send_email": [{"name": "EMAIL", "allowed_sender_addresses": ["accounts@yepnope.app"]}],
	"rules": [{"type": "Text", "globs": ["**/*.sql"], "fallthrough": true}],
	// Production's BETTER_AUTH_SECRET and VAPID_PRIVATE_JWK are Wrangler secrets.
	"vars": {
		"AUTH_EMAIL_FROM": "accounts@yepnope.app",
		"BETTER_AUTH_URL": "https://yepnope.app",
		"VAPID_SUBJECT": "mailto:push@yepnope.app",
	},
	"observability": {
		"enabled": true,
		"logs": {"enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true},
		"traces": {"enabled": true, "head_sampling_rate": 1, "persist": true},
	},
}

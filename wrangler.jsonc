{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "yepnope",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-17",
	"routes": [{"pattern": "yepnope.app", "custom_domain": true}],
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"],
	},
	"durable_objects": {
		"bindings": [{"name": "USER_DO", "class_name": "UserDurableObject"}],
	},
	"migrations": [{"tag": "v1", "new_sqlite_classes": ["UserDurableObject"]}],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "yepnope",
			"database_id": "063099d0-41c7-4b2b-8f6d-2acf3e9aac2f",
			"migrations_dir": "worker/migrations/d1",
		},
	],
	"rules": [{"type": "Text", "globs": ["**/*.sql"], "fallthrough": true}],
	// Production's VAPID_PRIVATE_JWK is a Wrangler secret; local development reads it from .dev.vars.
	"vars": {"VAPID_SUBJECT": "mailto:push@yepnope.app"},
	"observability": {"enabled": true},
}
